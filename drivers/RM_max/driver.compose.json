{
  "id": "RM_max",
  "name": { "en": "RM Max", "nl": "RM Max" },
  "images": { "small": "/drivers/RM_max/assets/images/small.png", "large": "/drivers/RM_max/assets/images/large.png" },
  "class": "other",
  "platforms": ["local"],
  "connectivity": ["cloud", "lan"],
  "capabilities": ["rmmax_status", "button.refresh", "button.local_test"],
  "capabilitiesOptions": {
    "button.refresh": { "title": { "en": "Refresh saved commands", "nl": "Opgeslagen commando's vernieuwen" } },
    "button.local_test": { "title": { "en": "Test local credentials", "nl": "Lokale gegevens testen" } }
  },
  "settings": [
    { "id": "ipAddress", "type": "text", "value": "", "label": { "en": "Local IP address", "nl": "Lokaal IP-adres" } },
    { "id": "transport", "type": "dropdown", "value": "cloud", "label": { "en": "Connection", "nl": "Verbinding" }, "values": [
      { "id": "cloud", "label": { "en": "Cloud", "nl": "Cloud" } },
      { "id": "local", "label": { "en": "Local after successful test", "nl": "Lokaal na geslaagde test" } }
    ] }
  ],
  "pair": [{ "id": "cloud" }],
  "repair": [{ "id": "cloud" }],
  "$flow": {
    "triggers": [{ "id": "RC_sent_any_rm_max", "title": { "en": "A remote command was sent", "nl": "Een afstandsbedieningscommando is verzonden" }, "tokens": [{ "name": "CommandSent", "type": "string", "title": { "en": "Command sent", "nl": "Verzonden commando" }, "example": { "en": "Power", "nl": "Aan/uit" } }] }],
    "actions": [
      { "id": "send_command_rm_max", "title": { "en": "Send a saved command", "nl": "Verstuur een opgeslagen commando" }, "titleFormatted": { "en": "Send command [[variable]]", "nl": "Verstuur commando [[variable]]" }, "args": [{ "name": "variable", "type": "autocomplete", "placeholder": { "en": "Command", "nl": "Commando" } }] },
      { "id": "refresh_commands_rm_max", "title": { "en": "Refresh saved commands", "nl": "Vernieuw opgeslagen commando's" } }
    ]
  }
}

